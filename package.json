{
  "name": "@garndev/wip-dev",
  "version": "0.5.0",
  "private": true,
  "description": "wip: per-project workflow state for Claude Code (development workspace)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jupegarnica/wip.git"
  },
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bun src/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.src.json",
    "lint": "biome check .",
    "build": "bun scripts/build.ts --targets host --out dist --pack",
    "install:local": "bun scripts/install-local.ts",
    "install:global": "bun scripts/install-global.ts",
    "vendor:markdown": "bun scripts/vendor-markdown.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/bun": "1.4.4",
    "@types/jsdom": "28.0.3",
    "@types/node": "26.6.6",
    "jsdom": "26.1.0",
    "marked": "18.2.0",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  }
}
